{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr create *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/pr-autopilot-trigger.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
